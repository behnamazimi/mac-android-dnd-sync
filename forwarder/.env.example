# SHA-256 hex of the 6.A pair secret. Unset to disable auto-seed.
DEV_PAIR_SECRET_HASH=
APNS_KEY_ID=
APNS_TEAM_ID=
# PEM contents of the APNs .p8 key. Use \n for newlines if needed.
APNS_P8=
# https://api.sandbox.push.apple.com while the Mac app runs from Xcode
# Debug; https://api.push.apple.com once you're running a Developer ID
# (or App Store) export, since Apple issues the Mac app a production
# device token in that case.
APNS_HOST=https://api.push.apple.com
APP_KEY=
