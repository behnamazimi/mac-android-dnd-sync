# Local stand-in for the Mac job in .github/workflows/release.yml.
# Copy to .env (gitignored), fill the empty values, then:
#
#   source .env
#   make dmg-mac
#
# Assignments are exported so make can see them. CI=true is what switches
# archive-mac and export-mac onto manual Developer ID signing
# (ExportOptions-DeveloperID-CI.plist + CI-signing.xcconfig). It also
# rewrites apps/macos/DNDSync/ForwarderSecrets.local.swift from
# FORWARDER_APP_KEY and FORWARDER_BASE_URL. Unset CI when you are done;
# it stays in this shell.
#
# This does not import a .p12 or install a .provisionprofile. The named
# profile must already be in ~/Library/Developer/Xcode/UserData/Provisioning Profiles,
# and it must contain the Developer ID Application certificate codesign
# will pick. CI gets that by importing one certificate into an empty
# keychain. A second "Developer ID Application: Behnam Azimi" certificate
# in the login keychain can still make export fail.

export CI=true

# Exact Name field inside the .provisionprofile, not the filename.
#   security cms -D -i ~/Library/Developer/Xcode/UserData/Provisioning\ Profiles/<uuid>.provisionprofile | plutil -extract Name raw -
# The Xcode-managed profile on this machine is named:
#   Mac Team Direct Provisioning Profile: com.dndsyncapp.macos
export MACOS_PROFILE_SPECIFIER=""

# Required while CI=true. Copy baseURL and appKey from
# apps/macos/DNDSync/ForwarderSecrets.local.swift.
export FORWARDER_BASE_URL=""
export FORWARDER_APP_KEY=""

# Optional. If all three are non-empty, notarize-mac uses them.
# Leave them empty to use the dndsync-notary keychain profile instead.
export NOTARY_APPLE_ID=""
export NOTARY_TEAM_ID=""
export NOTARY_PASSWORD=""
